    "Updated ^[%lld time](inflect: true)": {
      "comment": "English on purpose. Only the demo of Onboarding Pager is translated, and this keeps the plural of a demo that is not, where the app runs in Spanish.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Updated %lld time"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Updated %lld times"
                }
              }
            }
          }
        }
      }
    },
    "Welcome": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te damos la bienvenida"
          }
