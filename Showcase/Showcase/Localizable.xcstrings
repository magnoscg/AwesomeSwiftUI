{
  "sourceLanguage": "en",
  "strings": {
    "%lld of %lld": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld"
          }
        }
      }
    },
    "A calmer way to keep track of your day.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una forma más tranquila de llevar tu día."
          }
        }
      }
    },
