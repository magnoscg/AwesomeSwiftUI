---
// Starlight's title, with arrows beside it to the previous and next pages of
// the sidebar, so going through a category does not need the foot of each
// page. The page of a category also says what it holds under its title.
import { Icon } from '@astrojs/starlight/components';

const { entry, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const isCategory = Boolean(entry.data.sidebar.attrs?.['data-category-page']);
---

<div class="page-title">
  <h1 id="_top">{entry.data.title}</h1>
  {
    (prev || next) && (
      <nav class="steps" aria-label="Previous and next pages">
        {prev ? (
          <a href={prev.href} rel="prev" aria-label={`Previous: ${prev.label}`} title={prev.label}>
            <Icon name="left-arrow" size="1.1rem" />
          </a>
        ) : (
          <span aria-hidden="true">
            <Icon name="left-arrow" size="1.1rem" />
          </span>
        )}
        {next ? (
          <a href={next.href} rel="next" aria-label={`Next: ${next.label}`} title={next.label}>
            <Icon name="right-arrow" size="1.1rem" />
          </a>
        ) : (
          <span aria-hidden="true">
            <Icon name="right-arrow" size="1.1rem" />
          </span>
        )}
      </nav>
    )
  }
</div>
{isCategory && entry.data.description && <p class="lead">{entry.data.description}</p>}

<script>
  // Starlight marks the section whose heading crosses the top of the window, which the
  // last one never reaches when it is shorter than the window. At the end of a page that
  // scrolls, the last section is marked as soon as Starlight writes, so nothing races,
  // and what Starlight would mark comes back when the reader leaves the end.
  type Toc = HTMLElement & { current: HTMLAnchorElement; getRootMargin(): string };
  const atBottom = () => {
    const height = document.documentElement.scrollHeight;
    return height > window.innerHeight && window.innerHeight + window.scrollY >= height - 2;
  };
  const tocs = [...document.querySelectorAll<Toc>('starlight-toc, mobile-starlight-toc')];
  const links = (toc: Toc) => [...toc.querySelectorAll('a')];
  const current = (toc: Toc) => toc.querySelector<HTMLAnchorElement>('a[aria-current="true"]');
  // What Starlight would mark: the last heading that has reached the 53 px band it watches.
  const starlightChoice = (toc: Toc) => {
    const bandEnd = -parseFloat(toc.getRootMargin()) + 53;
    const reached = links(toc).filter((link) => {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      return heading && heading.getBoundingClientRect().top <= bandEnd;
    });
    return reached.at(-1) ?? links(toc)[0];
  };
  const forced = new Set<Toc>();
  const sync = () => {
    for (const toc of tocs) {
      const end = links(toc).at(-1);
      if (!end) continue;
      if (atBottom()) {
        if (current(toc) !== end) {
          forced.add(toc);
          toc.current = end;
        }
      } else if (forced.delete(toc)) {
        const choice = starlightChoice(toc);
        if (choice) toc.current = choice;
      }
    }
  };
  for (const toc of tocs) {
    new MutationObserver(sync).observe(toc, { subtree: true, attributeFilter: ['aria-current'] });
  }
  addEventListener('scroll', sync, { passive: true });
  addEventListener('load', sync);
</script>

<style>
  .page-title {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }

  h1 {
    margin: 0;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .steps {
    display: flex;
    flex-shrink: 0;
    gap: 0.4rem;
    margin-top: 0.2rem;
  }

  .steps a,
  .steps span {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
  }

  .steps span {
    opacity: 0.4;
  }

  .steps a {
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .steps a:hover,
  .steps a:focus-visible {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }

  .steps a[rel='prev']:hover {
    transform: translateX(-2px);
  }

  .steps a[rel='next']:hover {
    transform: translateX(2px);
  }

  .steps a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .steps a {
      transition: none;
    }

    .steps a[rel]:hover {
      transform: none;
    }
  }

  .lead {
    margin-top: 0.75rem;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-2);
  }
</style>
