---
// Starlight's title, with arrows beside it to the previous and next pages of
// the sidebar, so going through a category does not need the foot of each
// page. The page of a category also says what it holds under its title.
import { Icon } from '@astrojs/starlight/components';

const { entry, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const isCategory = Boolean(entry.data.sidebar.attrs?.['data-category-page']);
---

<div class="page-title">
  <h1 id="_top">{entry.data.title}</h1>
  {
    (prev || next) && (
      <nav class="steps" aria-label="Previous and next pages">
        {prev ? (
          <a href={prev.href} rel="prev" aria-label={`Previous: ${prev.label}`} title={prev.label}>
            <Icon name="left-arrow" size="1.1rem" />
          </a>
        ) : (
          <span aria-hidden="true">
            <Icon name="left-arrow" size="1.1rem" />
          </span>
        )}
        {next ? (
          <a href={next.href} rel="next" aria-label={`Next: ${next.label}`} title={next.label}>
            <Icon name="right-arrow" size="1.1rem" />
          </a>
        ) : (
          <span aria-hidden="true">
            <Icon name="right-arrow" size="1.1rem" />
          </span>
        )}
      </nav>
    )
  }
</div>
{isCategory && entry.data.description && <p class="lead">{entry.data.description}</p>}

<script>
  // Starlight marks the section whose heading crosses the top of the window, which the
  // last one never reaches when it is shorter than the window: it goes to the bottom
  // of the page, and to whichever link was followed.
  const tocs = () => [...document.querySelectorAll<HTMLElement & { current: HTMLAnchorElement }>('starlight-toc, mobile-starlight-toc')];
  const mark = (pick: (links: HTMLAnchorElement[]) => HTMLAnchorElement | undefined) => {
    for (const toc of tocs()) {
      const link = pick([...toc.querySelectorAll('a')]);
      if (link) toc.current = link;
    }
  };
  const atBottom = () => window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
  addEventListener('scroll', () => atBottom() && mark((links) => links.at(-1)), { passive: true });
  addEventListener('hashchange', () => mark((links) => links.find((link) => link.hash === location.hash)));
</script>

<style>
  .page-title {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }

  h1 {
    margin: 0;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .steps {
    display: flex;
    flex-shrink: 0;
    gap: 0.4rem;
    margin-top: 0.2rem;
  }

  .steps a,
  .steps span {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
  }

  .steps span {
    opacity: 0.4;
  }

  .steps a {
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .steps a:hover,
  .steps a:focus-visible {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }

  .steps a[rel='prev']:hover {
    transform: translateX(-2px);
  }

  .steps a[rel='next']:hover {
    transform: translateX(2px);
  }

  .steps a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .steps a {
      transition: none;
    }

    .steps a[rel]:hover {
      transform: none;
    }
  }

  .lead {
    margin-top: 0.75rem;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-2);
  }
</style>
