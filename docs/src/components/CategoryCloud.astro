---
// Every category with its count, each a link to the catalog filtered by it.
import { categories } from '../lib/catalog';
---

<ul class="category-cloud not-content">
  {
    categories.map((category) => (
      <li>
        <a href={category.href}>
          {category.name} <span>{category.count}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .category-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .category-cloud a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .category-cloud a:hover,
  .category-cloud a:focus-visible {
    border-color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 14%, var(--sl-color-black));
  }

  .category-cloud span {
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
  }
</style>
