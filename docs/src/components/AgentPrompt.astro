---
// The prompt that hands the catalog to a coding agent, in a box with a button
// to copy it.
const prompt = [
  'Find a SwiftUI component for <what you need> in',
  'https://raw.githubusercontent.com/magnoscg/swiftui-components/HEAD/llms.txt',
  'and copy its file into my project.',
].join('\n');
---

<div class="agent-prompt not-content">
  <div class="bar">
    <span>Paste into Claude Code, Codex, Cursor…</span>
    <button type="button" data-copy={prompt} data-done="Copied">Copy</button>
  </div>
  <pre tabindex="0"><code>{prompt}</code></pre>
  <p class="sr-only" role="status" data-copy-status></p>
</div>

<script>
  import '../lib/copy';
</script>

<style>
  .agent-prompt {
    max-width: 44rem;
    margin-block: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.9rem;
    background: var(--sl-color-gray-6);
    overflow: hidden;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0.5rem 0.4rem 1rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  button {
    min-width: 4.5rem;
    min-height: 2.25rem;
    padding: 0 0.9rem;
    border: 0;
    border-radius: 0.55rem;
    font: inherit;
    font-weight: 600;
    color: var(--sl-color-black);
    background: var(--sl-color-white);
    cursor: pointer;
  }

  /* Wider than it looks, so it answers in 44 points. */
  button::after {
    content: '';
    position: absolute;
    inset: -0.3rem;
  }

  button {
    position: relative;
  }

  pre {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    font-size: var(--sl-text-sm);
    line-height: 1.7;
    color: var(--sl-color-gray-1);
  }
</style>
