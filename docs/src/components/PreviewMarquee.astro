---
// Two rows of previews that drift in opposite directions under the hero.
// Every preview runs the whole loop on its own, with a delay that spreads them
// one slot apart: the one that leaves one edge comes back at the other, so a
// row needs no copies. With Reduce Motion on, the rows stand still and scroll
// by hand.
import { components, pageURL, previewBytes, previewURL } from '../lib/catalog';

const picks = [
  'HolographicCard', 'VoiceOrb', 'IntelligenceGlowBorder', 'WalletCardStack', 'DissolveShaderTransition',
  'GooeyFloatingMenu', 'ActivityRings', 'KaraokeLyricsText', 'SpinWheelRoulette', 'SynthwaveGridBackground',
  'RippleShaderEffect', 'LikeBurstButton', 'LiquidFillProgress', 'AuroraMeshBackground', 'TapbackReactionBubble',
  'DynamicIslandPill', 'ElasticDragButton', 'CandlestickChart', 'StoriesViewer', 'GlassToolStrip',
];
// A preview can weigh up to 2 MB. The landing page keeps to the light ones.
const maximumBytes = 700 * 1024;
const shown = picks
  .map((name) => components.find((component) => component.name === name))
  .filter((component) => component !== undefined)
  .filter((component) => previewBytes(component) <= maximumBytes);
// Both rows play every preview, so each spans the widest screens without a
// download more. The second starts halfway through, so they never line up.
const half = Math.ceil(shown.length / 2);
const rows = [shown, [...shown.slice(half), ...shown.slice(0, half)]];
const count = shown.length;
// The fraction of the loop each preview has already run, so that preview i
// starts in slot i whichever way its row drifts.
const offset = (index: number, reverse: boolean) => (reverse ? index + 1 : count - 1 - index) / count;
---

<div class="preview-marquee not-content" aria-label="Some of the components, playing" style={`--count: ${count}`}>
  {
    rows.map((row, rowIndex) => {
      const reverse = rowIndex === 1;
      return (
        <div class:list={['row', { reverse }]} aria-hidden={reverse ? 'true' : undefined}>
          <ul>
            {row.map((component, index) => (
              <li style={`--offset: ${offset(index, reverse)}`}>
                <a href={pageURL(component)} tabindex={reverse ? -1 : undefined}>
                  <img src={previewURL(component)} alt={component.title} width="160" height="348" loading="lazy" decoding="async" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      );
    })
  }
</div>

<style>
  .preview-marquee {
    --gap: 1rem;
    --card-width: 160px;
    --card-height: calc(var(--card-width) * 874 / 402);
    --slot: calc(var(--card-width) + var(--gap));
    --loop: calc(var(--count) * var(--slot));
    --duration: calc(var(--count) * 7.8s);
    display: grid;
    gap: var(--gap);
    margin: 2.5rem calc(50% - 50vw) 1rem;
    padding-block: 0.5rem;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }

  .row ul {
    position: relative;
    height: var(--card-height);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row li {
    position: absolute;
    inset-block-start: 0;
    left: 0;
    width: var(--card-width);
    animation: drift var(--duration) linear infinite;
    animation-delay: calc(var(--duration) * var(--offset) * -1);
  }

  .row.reverse li {
    animation-direction: reverse;
  }

  .preview-marquee:hover li,
  .preview-marquee:focus-within li {
    animation-play-state: paused;
  }

  .row a {
    display: block;
    border-radius: 1.6rem;
    outline-offset: 3px;
  }

  .row img {
    display: block;
    width: var(--card-width);
    height: auto;
    aspect-ratio: 402 / 874;
    object-fit: cover;
    border-radius: 1.6rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-white) 14%, transparent);
    background: var(--sl-color-gray-6);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.55);
    transition: transform 0.25s ease;
  }

  .row a:hover img,
  .row a:focus-visible img {
    transform: translateY(-4px) scale(1.02);
  }

  @keyframes drift {
    from {
      transform: translateX(calc(var(--loop) - var(--slot)));
    }
    to {
      transform: translateX(calc(var(--slot) * -1));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preview-marquee {
      overflow-x: auto;
      mask-image: none;
    }

    .row ul {
      display: flex;
      gap: var(--gap);
      width: max-content;
      height: auto;
    }

    .row li {
      position: static;
      animation: none;
    }

    .row img {
      transition: none;
    }
  }
</style>
