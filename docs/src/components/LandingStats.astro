---
// The catalog in four figures, counted from catalog.json when the site builds.
import { categories, count } from '../lib/catalog';

const stats = [
  { value: String(count), label: 'components' },
  { value: String(categories.length), label: 'categories' },
  { value: '18 – 27', label: 'iOS versions' },
  { value: '0', label: 'packages to install' },
];
---

<dl class="landing-stats not-content">
  {
    stats.map((stat) => (
      <div>
        <dt>{stat.label}</dt>
        <dd>{stat.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .landing-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1px;
    margin: 2.5rem 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    background: var(--sl-color-gray-5);
    overflow: hidden;
  }

  .landing-stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.15rem;
    padding: 1.25rem 1rem;
    background: var(--sl-color-black);
    text-align: center;
  }

  .landing-stats dt {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .landing-stats dd {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-white);
  }
</style>
